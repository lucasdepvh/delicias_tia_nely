<% content_for :title, "Pedidos" %>
<section class="admin-orders"><header class="admin-resource__heading"><div><p class="admin-dashboard__eyebrow">Operação</p><h1>Pedidos</h1><p>Pedidos recebidos pelo checkout da loja.</p></div></header><%= form_with url: admin_orders_path, method: :get, class: "admin-orders__filters" do |form| %><%= form.search_field :q, value: @query, placeholder: "Pedido, cliente ou telefone", aria: { label: "Buscar pedidos" } %><%= form.select :status, [["Todos os status", ""]] + Order.statuses.keys.map { |status| [Order.new(status: status).status_label, status] }, selected: @status %><%= form.button "Filtrar", class: "button" %><% end %><% if @orders.any? %><div class="admin-orders__table"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Status</th><th>Recebimento</th><th>Total</th><th>Data</th><th></th></tr></thead><tbody><% @orders.each do |order| %><tr><td><strong><%= order.number %></strong></td><td><strong><%= order.customer.name %></strong><small><%= order.customer.phone %></small></td><td><span class="admin-order-status admin-order-status--<%= order.status %>"><%= order.status_label %></span></td><td><%= order.delivery? ? "Entrega" : "Retirada" %></td><td><strong><%= format_brl(order.total) %></strong></td><td><%= l(order.created_at, format: :short) %></td><td><%= link_to admin_order_path(order), class: "admin-orders__view", aria: { label: "Ver pedido #{order.number}" } do %><span class="material-symbols-rounded" aria-hidden="true">visibility</span><span>Ver</span><% end %></td></tr><% end %></tbody></table></div><% else %><div class="admin-resource__empty"><strong>Nenhum pedido encontrado.</strong><span>Quando o checkout estiver concluído, os pedidos realizados no site aparecerão aqui.</span></div><% end %></section>
