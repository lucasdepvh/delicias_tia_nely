<% content_for :title, "Recuperar senha" %>
<div class="auth-card">
  <h1>Recuperar senha</h1>
  <p>Informe o e-mail do administrador. O envio depende da configuração de e-mail do ambiente.</p>
  <%= form_with model: resource, as: resource_name, url: password_path(resource_name) do |form| %>
    <div class="field"><%= form.label :email, "E-mail" %><%= form.email_field :email, autofocus: true, autocomplete: "email", required: true %></div>
    <%= form.submit "Enviar instruções", class: "button" %>
  <% end %>
  <p><%= link_to "Voltar para entrar", new_admin_session_path, class: "auth-back-link" %></p>
</div>
