<%= form_with model: [:admin, customer], class: "admin-form" do |form| %>
  <% if customer.errors.any? %><div class="flash flash--alert" role="alert"><%= customer.errors.full_messages.to_sentence %></div><% end %>
  <div class="admin-form__split"><div class="admin-form__field"><%= form.label :name, "Nome" %><%= form.text_field :name, required: true %></div><div class="admin-form__field"><%= form.label :phone, "Telefone" %><%= form.telephone_field :phone, required: true, autocomplete: "tel", data: { controller: "input-mask", input_mask_type_value: "phone", action: "input->input-mask#format" } %></div></div>
  <div class="admin-form__field"><%= form.label :email, "E-mail (opcional)" %><%= form.email_field :email %></div>
  <fieldset class="admin-form__fieldset"><legend>Endereço</legend><div class="admin-form__split"><div class="admin-form__field"><%= form.label :zip_code, "CEP" %><%= form.text_field :zip_code, inputmode: "numeric", autocomplete: "postal-code", data: { controller: "input-mask", input_mask_type_value: "postal-code", action: "input->input-mask#format" } %></div><div class="admin-form__field"><%= form.label :state, "UF" %><%= form.text_field :state, maxlength: 2 %></div></div><div class="admin-form__field"><%= form.label :street, "Rua" %><%= form.text_field :street %></div><div class="admin-form__split"><div class="admin-form__field"><%= form.label :number, "Número" %><%= form.text_field :number %></div><div class="admin-form__field"><%= form.label :neighborhood, "Bairro" %><%= form.text_field :neighborhood %></div></div><div class="admin-form__field"><%= form.label :city, "Cidade" %><%= form.text_field :city %></div><div class="admin-form__field"><%= form.label :complement, "Complemento" %><%= form.text_field :complement %></div></fieldset>
  <div class="admin-form__field"><%= form.label :reference, "Referência" %><%= form.text_field :reference %></div><div class="admin-form__field"><%= form.label :notes, "Observações" %><%= form.text_area :notes %></div>
  <div class="admin-form__footer"><%= link_to "Cancelar", admin_customer_path(customer), class: "admin-form__cancel" %><%= form.submit "Salvar cliente", class: "button" %></div>
<% end %>
