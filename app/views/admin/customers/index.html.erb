<% content_for :title, "Clientes" %>
<div class="admin-resource"><div class="admin-resource__heading"><div><p class="admin-dashboard__eyebrow">Relacionamento</p><h1>Clientes</h1><p>Clientes serão cadastrados automaticamente ao concluir um pedido.</p></div></div>
  <% if @customers.any? %><div class="admin-resource__list"><% @customers.each do |customer| %><article><div><strong><%= customer.name %></strong><small><%= format_phone(customer.phone) %><%= " · #{customer.city}/#{customer.state}" if customer.city.present? && customer.state.present? %><%= " · #{pluralize(customer.orders_count.to_i, "pedido vinculado", "pedidos vinculados")}" %></small></div><div class="admin-resource__actions admin-customer-actions"><%= link_to admin_customer_path(customer), aria: { label: "Ver cliente #{customer.name}" }, title: "Ver cliente" do %><span class="material-symbols-rounded" aria-hidden="true">visibility</span><% end %><%= link_to edit_admin_customer_path(customer), aria: { label: "Editar cliente #{customer.name}" }, title: "Editar cliente" do %><span class="material-symbols-rounded" aria-hidden="true">edit</span><% end %><%= button_to admin_customer_path(customer), method: :delete, form: { data: { turbo_confirm: "Excluir este cliente? Esta ação só é possível sem pedidos vinculados." } }, class: "admin-resource__delete", aria: { label: "Excluir cliente #{customer.name}" }, title: "Excluir cliente" do %><span class="material-symbols-rounded" aria-hidden="true">delete</span><% end %></div></article><% end %></div><% else %><div class="admin-resource__empty"><strong>Nenhum cliente cadastrado.</strong><span>O cadastro de clientes será iniciado pelo checkout quando ele estiver implementado.</span></div><% end %>
</div>
