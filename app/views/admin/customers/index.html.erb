<% content_for :title, "Clientes" %>
<div class="admin-resource"><div class="admin-resource__heading"><div><p class="admin-dashboard__eyebrow">Relacionamento</p><h1>Clientes</h1><p>Clientes serão cadastrados automaticamente ao concluir um pedido.</p></div></div>
  <% if @customers.any? %><div class="admin-resource__list"><% @customers.each do |customer| %><article><div><strong><%= customer.name %></strong><small><%= customer.phone %><%= " · #{customer.city}/#{customer.state}" if customer.city.present? && customer.state.present? %></small></div><div class="admin-resource__actions"><%= link_to "Ver", admin_customer_path(customer) %><%= link_to "Editar", edit_admin_customer_path(customer) %><%= button_to "Excluir", admin_customer_path(customer), method: :delete, form: { data: { turbo_confirm: "Excluir este cliente? Esta ação só é possível sem pedidos vinculados." } }, class: "admin-resource__delete" %></div></article><% end %></div><% else %><div class="admin-resource__empty"><strong>Nenhum cliente cadastrado.</strong><span>O cadastro de clientes será iniciado pelo checkout quando ele estiver implementado.</span></div><% end %>
</div>
