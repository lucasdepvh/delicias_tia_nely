<% content_for :title, @financial_entry.description %>
<div class="admin-resource"><div class="admin-resource__heading"><div><p class="admin-dashboard__eyebrow">Financeiro comercial</p><h1><%= @financial_entry.description %></h1><p><%= @financial_entry.income? ? "Receita" : "Despesa" %> · <%= format_brl(@financial_entry.amount) %></p></div><% unless @financial_entry.automatic? %><%= link_to "Editar", edit_admin_financial_entry_path(@financial_entry), class: "button" %><% end %></div><div class="admin-resource__empty"><strong><%= @financial_entry.status == "paid" ? "Pago" : @financial_entry.status == "cancelled" ? "Cancelado" : "Pendente" %></strong><span>Vencimento: <%= @financial_entry.due_date&.strftime("%d/%m/%Y") || "Não informado" %></span><% if @financial_entry.paid_at.present? %><span>Pagamento: <%= @financial_entry.paid_at.strftime("%d/%m/%Y") %></span><% end %><% if @financial_entry.notes.present? %><span>Observações: <%= @financial_entry.notes %></span><% end %></div></div>
