<%= form_with model: [:admin, financial_entry], class: "admin-form" do |form| %>
  <% if financial_entry.errors.any? %><div class="flash flash--alert" role="alert"><%= financial_entry.errors.full_messages.to_sentence %></div><% end %>
  <div class="admin-form__field"><%= form.label :description, "Descrição" %><%= form.text_field :description, required: true %></div><div class="admin-form__split"><div class="admin-form__field"><%= form.label :entry_type, "Tipo" %><%= form.select :entry_type, [["Receita", "income"], ["Despesa", "expense"]] %></div><div class="admin-form__field"><%= form.label :status, "Situação" %><%= form.select :status, [["Pendente", "pending"], ["Pago", "paid"], ["Cancelado", "cancelled"]] %></div></div><div class="admin-form__split"><div class="admin-form__field"><%= form.label :amount, "Valor" %><%= form.text_field :amount, inputmode: "numeric", required: true, data: { controller: "input-mask", input_mask_type_value: "currency", action: "input->input-mask#formatCurrency" } %></div><div class="admin-form__field"><%= form.label :due_date, "Vencimento" %><%= form.date_field :due_date, required: true %></div></div><div class="admin-form__field"><%= form.label :paid_at, "Data de pagamento" %><%= form.date_field :paid_at %></div><div class="admin-form__field"><%= form.label :notes, "Observações" %><%= form.text_area :notes %></div><div class="admin-form__footer"><%= link_to "Cancelar", admin_financial_entries_path, class: "admin-form__cancel" %><%= form.submit "Salvar lançamento", class: "button" %></div>
<% end %>
