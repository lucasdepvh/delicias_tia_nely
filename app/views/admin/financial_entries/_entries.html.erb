<section class="admin-finance__section"><header><h2><%= title %></h2><strong><%= format_brl(total) %></strong></header><% if entries.any? %><% entries.each do |entry| %><article><div><strong><%= entry.description %></strong><small><%= entry.automatic? ? "Automático · pedido" : "Manual" %></small></div><span><%= entry.paid? ? "Pago" : entry.cancelled? ? "Cancelado" : "Pendente" %></span><b><%= format_brl(entry.amount) %></b><% unless entry.automatic? %><%= link_to "Editar", edit_admin_financial_entry_path(entry) %><% end %></article><% end %><% else %><p><%= empty %></p><% end %></section>
