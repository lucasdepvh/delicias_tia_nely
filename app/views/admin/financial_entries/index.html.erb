<% content_for :title, "Financeiro" %><section class="admin-finance"><header class="admin-resource__heading"><div><p class="admin-dashboard__eyebrow">Financeiro comercial</p><h1>Financeiro</h1><p>Receitas e despesas separadas para uma leitura clara.</p></div><%= link_to "Novo lançamento", new_admin_financial_entry_path, class: "button" %></header><div class="admin-finance__totals"><article><span>Receitas no filtro</span><strong><%= format_brl(@income_total) %></strong></article><article><span>Despesas no filtro</span><strong><%= format_brl(@expense_total) %></strong></article><article><span>Saldo no filtro</span><strong><%= format_brl(@income_total - @expense_total) %></strong></article></div><%= form_with url: admin_financial_entries_path, method: :get, class: "admin-finance__filters" do |f| %><%= f.search_field :q, value: @filters[:q], placeholder: "Descrição" %><%= f.select :entry_type, [["Receitas e despesas", ""], ["Receitas", "income"], ["Despesas", "expense"]], selected: @filters[:entry_type] %><%= f.select :status, [["Todos os status", ""], ["Pendente", "pending"], ["Pago", "paid"], ["Cancelado", "cancelled"]], selected: @filters[:status] %><%= f.select :origin, [["Todas as origens", ""], ["Manual", "manual"], ["Automática", "automatic"]], selected: @filters[:origin] %><%= f.submit "Aplicar filtros", class: "button" %><%= link_to "Limpar", admin_financial_entries_path %><% end %><div class="admin-finance__columns"><%= render "entries", title: "Receitas", entries: @income_entries, total: @income_total, empty: "Nenhuma receita encontrada." %><%= render "entries", title: "Despesas", entries: @expense_entries, total: @expense_total, empty: "Nenhuma despesa encontrada." %></div></section>
