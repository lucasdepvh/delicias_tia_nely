<% content_for :title, "Visão geral" %><section class="admin-overview"><header class="admin-resource__heading"><div><p class="admin-dashboard__eyebrow">Dashboard</p><h1>Visão geral</h1><p>Resumo operacional da loja.</p></div><div class="admin-overview__actions"><%= link_to "Ver pedidos", admin_orders_path, class: "admin-form__cancel" %><%= link_to "Novo produto", new_admin_product_path, class: "button" %></div></header><section class="admin-overview__store"><span class="material-symbols-rounded">storefront</span><div><small>Status da loja</small><strong><%= @store_setting.accepting_orders? ? "Online para receber pedidos" : "Loja pausada" %></strong><p><%= @store_setting.accepting_orders? ? "Novos pedidos podem ser iniciados." : "Novos pedidos ficam bloqueados até a reativação." %></p></div><%= button_to admin_toggle_orders_path, class: "admin-overview__toggle", form: { data: { turbo_confirm: @store_setting.accepting_orders? ? "Pausar novos pedidos?" : "Habilitar novos pedidos?" } } do %><span class="material-symbols-rounded"><%= @store_setting.accepting_orders? ? "pause_circle" : "play_circle" %></span><%= @store_setting.accepting_orders? ? "Pausar pedidos" : "Ativar pedidos" %><% end %></section><div class="admin-overview__metrics"><article><span>Faturamento hoje</span><strong><%= format_brl(@today_total) %></strong></article><article><span>Pedidos pendentes</span><strong><%= @pending_orders %></strong></article><article><span>Pedidos do dia</span><strong><%= @today_orders.respond_to?(:count) ? @today_orders.count : 0 %></strong></article><article><span>Alertas de estoque</span><strong><%= @low_stock_products.count %></strong></article></div><div class="admin-overview__grid"><section><header><h2>Alertas de estoque</h2><%= link_to "Produtos", admin_products_path %></header><% if @low_stock_products.any? %><% @low_stock_products.each do |product| %><article><span class="material-symbols-rounded">inventory_2</span><div><strong><%= product.name %></strong><small><%= product.quantity.zero? ? "Esgotado" : "Estoque baixo: #{product.quantity}" %></small></div><%= link_to edit_admin_product_path(product) do %><span class="material-symbols-rounded">edit</span><% end %></article><% end %><% else %><p>Nenhum alerta de estoque no momento.</p><% end %></section><section><header><h2>Ações rápidas</h2></header><%= link_to new_admin_product_path do %><span>Adicionar produto</span><span class="material-symbols-rounded">add</span><% end %><%= link_to admin_orders_path do %><span>Conferir pedidos</span><span class="material-symbols-rounded">arrow_forward</span><% end %><%= link_to admin_financial_entries_path do %><span>Ver financeiro</span><span class="material-symbols-rounded">account_balance_wallet</span><% end %></section></div><section class="admin-overview__recent"><header><h2>Vendas recentes</h2><%= link_to "Ver todos", admin_orders_path %></header><% if @recent_orders.any? %><% @recent_orders.each do |order| %><article><strong><%= order.number %></strong><span><%= order.customer.name %></span><span><%= format_brl(order.total) %></span><span><%= order.status_label %></span><%= link_to admin_order_path(order) do %><span class="material-symbols-rounded">visibility</span><% end %></article><% end %><% else %><p>Os pedidos recentes aparecerão aqui quando o checkout estiver disponível.</p><% end %></section></section>
