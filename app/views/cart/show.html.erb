<% content_for :title, "Carrinho" %>
<section class="commerce-page" aria-labelledby="carrinho-titulo"><p class="storefront-kicker">Seu pedido</p><h1 id="carrinho-titulo">Carrinho</h1>
  <% if @cart.empty? %><div class="commerce-empty"><p>Seu carrinho está vazio.</p><%= link_to "Conhecer o cardápio", produtos_path, class: "storefront-primary-action" %></div><% else %>
    <div class="cart-layout"><div class="cart-items"><% @cart.items.each do |item| %><article class="cart-item"><div><h2><%= item.name %></h2><p><%= format_brl(item.unit_price) %> por unidade</p></div><div class="cart-item__actions"><%= form_with url: cart_item_path(item.key), method: :patch do |form| %><%= number_field_tag "cart_item[quantity]", item.quantity, min: 0, max: 99, aria: { label: "Quantidade de #{item.name}" } %><%= form.submit "Atualizar" %><% end %><strong><%= format_brl(item.total) %></strong><%= button_to "Remover", cart_item_path(item.key), method: :delete, class: "cart-item__remove" %></div></article><% end %><%= button_to "Esvaziar carrinho", carrinho_path, method: :delete, class: "cart-item__remove", data: { turbo_confirm: "Esvaziar todo o carrinho?" } %></div><aside class="order-summary"><h2>Resumo</h2><p><span>Subtotal</span><strong><%= format_brl(@cart.subtotal) %></strong></p><p class="order-summary__total"><span>Total parcial</span><strong><%= format_brl(@cart.subtotal) %></strong></p><small>Frete será calculado no checkout para entregas.</small><%= link_to "Finalizar pedido", finalizar_pedido_path, class: "storefront-primary-action" %></aside></div>
  <% end %>
</section>
