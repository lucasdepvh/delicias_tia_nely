<% content_for :title, "Finalizar pedido" %>
<section class="commerce-page" data-controller="checkout" aria-labelledby="checkout-titulo"><p class="storefront-kicker">Último passo</p><h1 id="checkout-titulo">Finalizar pedido</h1>
  <%= form_with url: finalizar_pedido_path, class: "checkout-layout", data: { turbo: false } do |form| %><div class="checkout-form">
    <% if @order.errors.any? || @customer.errors.any? %><div class="form-errors"><strong>Revise os campos indicados:</strong><ul><% (@order.errors.full_messages + @customer.errors.full_messages).uniq.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
    <fieldset><legend>Identificação</legend><label>Nome <%= text_field_tag "customer[name]", @customer.name, required: true, autocomplete: "name" %></label><label>WhatsApp <%= telephone_field_tag "customer[phone]", @customer.phone, required: true, autocomplete: "tel" %></label><label>E-mail (opcional) <%= email_field_tag "customer[email]", @customer.email, autocomplete: "email" %></label></fieldset>
    <fieldset><legend>Recebimento</legend><label><%= radio_button_tag "order[fulfillment_method]", "pickup", @order.pickup?, data: { action: "checkout#toggleDelivery" } %> Retirada</label><label><%= radio_button_tag "order[fulfillment_method]", "delivery", @order.delivery?, data: { action: "checkout#toggleDelivery" } %> Entrega</label></fieldset>
    <fieldset data-checkout-target="address" class="checkout-address <%= 'is-hidden' unless @order.delivery? %>"><legend>Endereço de entrega</legend><label>CEP <%= text_field_tag "customer[zip_code]", @customer.zip_code, inputmode: "numeric" %></label><label>Rua <%= text_field_tag "customer[street]", @customer.street %></label><label>Número <%= text_field_tag "customer[number]", @customer.number %></label><label>Bairro <%= text_field_tag "customer[neighborhood]", @customer.neighborhood %></label><label>Cidade <%= text_field_tag "customer[city]", @customer.city %></label><label>UF <%= text_field_tag "customer[state]", @customer.state, maxlength: 2 %></label><label>Complemento <%= text_field_tag "customer[complement]", @customer.complement %></label><label>Referência <%= text_field_tag "customer[reference]", @customer.reference %></label></fieldset>
    <fieldset><legend>Pagamento</legend><label>Forma de pagamento <%= select_tag "order[payment_method]", options_for_select([["Pix", "pix"], ["Cartão", "card"], ["Dinheiro", "cash"], ["Cartão na entrega", "card_delivery"], ["Cartão na retirada", "card_pickup"], ["Transferência", "transfer"], ["Outro", "other"]], @order.payment_method) %></label><label>Troco para (somente dinheiro) <%= number_field_tag "order[change_for]", @order.change_for, min: 0, step: "0.01" %></label><label>Observações <%= text_area_tag "order[notes]", @order.notes %></label></fieldset><%= form.submit "Confirmar e abrir WhatsApp", class: "storefront-primary-action" %>
  </div><aside class="order-summary checkout-summary"><h2>Resumo do pedido</h2><% @cart.items.each do |item| %><p><span><%= item.quantity %> × <%= item.name %></span><strong><%= format_brl(item.total) %></strong></p><% end %><p><span>Subtotal</span><strong><%= format_brl(@cart.subtotal) %></strong></p><p class="order-summary__total"><span>Total parcial</span><strong><%= format_brl(@cart.subtotal) %></strong></p><small>O valor do frete, se houver, será confirmado para entrega.</small></aside><% end %>
</section>
