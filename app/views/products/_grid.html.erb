<% if products.any? %>
  <% store_setting = local_assigns.fetch(:store_setting, @store_setting || StoreSetting.current) %>
  <div class="product-grid">
    <% products.each do |product| %>
      <article class="product-card">
        <%= link_to produto_path(product.slug), class: "product-card__link", aria: { label: "Ver detalhes de #{product.name}" } do %>
          <div class="product-card__visual">
            <% if product.main_image_attached? %><%= image_tag product.main_image, alt: "Imagem de #{product.name}" %><% else %><span aria-hidden="true"><%= product.name.first.upcase %></span><% end %>
            <% if product.featured? %><small>Destaque</small><% end %>
          </div>
          <div class="product-card__content">
            <p class="product-card__category"><%= product.category.name %></p>
            <h2><%= product.name %></h2>
            <% if product.description.present? %><p class="product-card__description"><%= truncate(product.description, length: 104) %></p><% end %>
            <div class="product-card__footer">
              <strong><%= format_brl(product.price) %></strong>
              <span class="product-card__availability <%= "product-card__availability--unavailable" unless product.available? %>"><%= product.available? ? "Disponível" : "Indisponível" %></span>
            </div>
          </div>
        <% end %>
        <div class="product-card__actions">
          <% if product.available? && store_setting.accepting_orders? %>
            <% if product.product_variants.any?(&:active?) %>
              <%= link_to "Comprar", produto_path(product.slug), class: "product-card__buy", aria: { label: "Escolher opção e comprar #{product.name}" } %>
            <% else %>
              <%= form_with url: cart_items_path, scope: :cart_item, class: "product-card__purchase", data: { turbo_stream: true } do |form| %>
                <%= form.hidden_field :product_id, value: product.id %>
                <%= form.hidden_field :quantity, value: 1 %>
                <%= form.submit "Comprar", class: "product-card__buy" %>
              <% end %>
            <% end %>
          <% elsif product.available? %>
            <button type="button" class="product-card__buy product-card__buy--disabled" disabled aria-describedby="store-paused-message">Pedidos pausados</button>
          <% else %>
            <button type="button" class="product-card__buy product-card__buy--disabled" disabled>Indisponível</button>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="storefront-empty-card">
    <div class="storefront-empty-card__icon" aria-hidden="true">♡</div>
    <p class="storefront-kicker">Novidades chegando</p>
    <h2>Os sabores serão publicados aqui.</h2>
    <p>A loja ainda está organizando produtos, disponibilidade e formas de pedido. Assim que tudo estiver pronto, esta vitrine será atualizada.</p>
  </div>
<% end %>
