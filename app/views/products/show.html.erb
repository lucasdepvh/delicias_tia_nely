<% content_for :title, @product.name %>
<% content_for :description, @product.description.presence || "Conheça #{@product.name}, um sabor da #{brand_name}." %>
<article class="product-detail" aria-labelledby="produto-titulo">
  <%= link_to "← Voltar aos produtos", produtos_path, class: "product-detail__back" %>
  <div class="product-detail__visual"><% if @product.main_image_attached? %><%= image_tag @product.main_image, alt: "Imagem de #{@product.name}" %><% else %><span aria-hidden="true"><%= @product.name.first.upcase %></span><% end %></div>
  <div class="product-detail__content"><p class="storefront-kicker"><%= @product.category.name %></p><h1 id="produto-titulo"><%= @product.name %></h1><p class="product-detail__price"><%= "A partir de " if @variants.any? %><%= format_brl(@product.price) %></p><p class="product-detail__availability <%= "product-detail__availability--unavailable" unless @product.available? %>"><%= @product.available? ? "Disponível no cardápio" : "Indisponível no momento" %></p>
    <% if @product.description.present? %><div class="product-detail__description"><h2>Sobre este sabor</h2><%= simple_format(@product.description) %></div><% end %>
    <% if @variants.any? && @available_variants.empty? %><section class="product-detail__variant-list" aria-labelledby="opcoes-titulo"><h2 id="opcoes-titulo">Opções e preços</h2><p>Estas opções serão liberadas quando a loja informar o estoque disponível.</p><ul><% @variants.each do |variant| %><li><span><%= variant.name %></span><strong><%= format_brl(variant.effective_price) %></strong><small>Indisponível no momento</small></li><% end %></ul></section><% end %>
    <% if @store_setting.accepting_orders? && @product.available? %>
      <%= form_with url: cart_items_path, scope: :cart_item, class: "product-purchase" do |form| %><%= form.hidden_field :product_id, value: @product.id %>
        <% if @variants.any? %><fieldset class="product-detail__variants"><legend>Escolha uma opção</legend><p>Selecione o tamanho ou sabor desejado.</p><div class="product-detail__variant-options"><% @variants.each do |variant| %><label class="product-detail__variant-option <%= "product-detail__variant-option--unavailable" unless variant.available? %>"><%= form.radio_button :variant_id, variant.id, required: true, disabled: !variant.available? %><span class="product-detail__variant-option-name"><%= variant.name %></span><strong><%= format_brl(variant.effective_price) %></strong><small><%= variant.available? ? "Disponível" : "Indisponível" %></small></label><% end %></div></fieldset><% end %>
        <label class="product-purchase__quantity">Quantidade <%= form.number_field :quantity, value: 1, min: 1, max: 99 %></label><%= form.submit "Adicionar ao carrinho", class: "storefront-primary-action" %>
      <% end %>
    <% elsif !@store_setting.accepting_orders? %><p class="product-detail__notice"><%= @store_setting.pause_message.presence || StoreSetting::DEFAULT_PAUSE_MESSAGE %></p>
    <% else %><p class="product-detail__notice">Este produto está indisponível no momento.</p><% end %>
  </div>
  <% if @related_products.any? %><section class="product-detail__related" aria-labelledby="relacionados-titulo"><h2 id="relacionados-titulo">Você também pode gostar</h2><%= render "grid", products: @related_products %></section><% end %>
</article>
