<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="<%= asset_path('Logo Principal.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path('Logo Principal.png') %>">
    <title><%= page_title(content_for(:title)) %></title>
    <meta name="description" content="<%= page_description(content_for(:description)) %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:site_name" content="<%= brand_name %>">
    <meta property="og:title" content="<%= page_title(content_for(:title)) %>">
    <meta property="og:description" content="<%= page_description(content_for(:description)) %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag "style", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="storefront-body" data-controller="cart-drawer">
    <header class="storefront-header">
      <div class="storefront-header__inner">
        <%= link_to root_path, class: "storefront-brand", aria: { label: "Página inicial de #{brand_name}" } do %>
          <%= image_tag "Logo Principal.png", class: "storefront-brand__mark", alt: "Logo Delícias da Tia Nely" %>
          <span><strong><%= brand_name %></strong><small>Sabores preparados com carinho</small></span>
        <% end %>
        <nav class="storefront-nav" aria-label="Navegação principal">
          <%= link_to "Cardápio", root_path, aria: { current: current_page?(root_path) || current_page?(produtos_path) || current_page?(sabores_path) ? "page" : nil } %>
          <%= link_to "Quem somos", quem_somos_path %>
          <%= link_to "Contato", contato_path %>
          <%= link_to carrinho_path, class: "storefront-cart-link", data: { action: "click->cart-drawer#open" }, aria: { label: "Abrir carrinho" } do %>
            Carrinho <span data-cart-drawer-target="count"><%= current_cart.quantity %></span>
          <% end %>
          <% if admin_signed_in? %>
            <%= link_to "Administração", admin_root_path, class: "storefront-nav__admin" %>
          <% else %>
            <%= link_to "Administração", new_admin_session_path, class: "storefront-nav__admin" %>
          <% end %>
        </nav>
      </div>
    </header>
    <% flash.each do |type, message| %>
      <div class="shell flash <%= "flash--alert" if type.to_s == "alert" %>" role="status"><%= message %></div>
    <% end %>
    <main class="storefront-main"><%= yield %></main>
    <aside class="cart-drawer" data-cart-drawer-target="drawer" aria-label="Carrinho" aria-hidden="true">
      <div class="cart-drawer__backdrop" data-action="click->cart-drawer#close"></div>
      <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Carrinho de compras">
        <button type="button" class="cart-drawer__close" data-action="cart-drawer#close">Fechar ×</button><h2>Seu carrinho</h2>
        <% if current_cart.empty? %><p>Você ainda não adicionou itens.</p><% else %>
          <% current_cart.items.each do |item| %><div class="cart-drawer__item"><div><strong><%= item.name %></strong><small><%= item.quantity %> × <%= format_brl(item.unit_price) %></small><%= form_with url: cart_item_path(item.key), method: :patch, class: "cart-drawer__update" do |form| %><%= number_field_tag "cart_item[quantity]", item.quantity, min: 0, max: 99, aria: { label: "Quantidade de #{item.name}" } %><%= form.submit "Atualizar" %><% end %><%= button_to "Remover", cart_item_path(item.key), method: :delete, class: "cart-drawer__remove" %></div><strong><%= format_brl(item.total) %></strong></div><% end %>
          <p class="cart-drawer__total">Total parcial <strong><%= format_brl(current_cart.subtotal) %></strong></p><%= link_to "Ver carrinho", carrinho_path, class: "storefront-primary-action" %>
        <% end %>
      </div>
    </aside>
    <footer class="storefront-footer">
      <div class="storefront-footer__inner">
        <div>
          <strong><%= brand_name %></strong>
          <p>Sabores feitos com cuidado, para compartilhar bons momentos.</p>
        </div>
        <nav aria-label="Links do rodapé">
          <%= link_to "Cardápio", produtos_path %>
          <%= link_to "Quem somos", quem_somos_path %>
          <%= link_to "Contato", contato_path %>
        </nav>
        <small>© <%= Time.zone.today.year %> <%= brand_name %>.</small>
      </div>
    </footer>
  </body>
</html>
