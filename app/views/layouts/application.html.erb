<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="<%= asset_path('Logo Principal.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path('Logo Principal.png') %>">
    <title><%= page_title(content_for(:title)) %></title>
    <meta name="description" content="<%= page_description(content_for(:description)) %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:site_name" content="<%= brand_name %>">
    <meta property="og:title" content="<%= page_title(content_for(:title)) %>">
    <meta property="og:description" content="<%= page_description(content_for(:description)) %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag "style", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="storefront-body <%= "storefront-body--checkout" if controller_path == "checkout" %>" data-controller="cart-drawer">
    <header class="storefront-header">
      <div class="storefront-header__inner">
        <%= link_to root_path, class: "storefront-brand", aria: { label: "Página inicial de #{brand_name}" } do %>
          <%= image_tag "Logo Principal.png", class: "storefront-brand__mark", alt: "Logo Delícias da Tia Nely" %>
          <span><strong><%= brand_name %></strong><small>Sabores preparados com carinho</small></span>
        <% end %>
        <nav class="storefront-nav" aria-label="Navegação principal">
          <%= link_to "Cardápio", root_path, aria: { current: current_page?(root_path) || current_page?(produtos_path) || current_page?(sabores_path) ? "page" : nil } %>
          <%= link_to "Quem somos", quem_somos_path %>
          <% if admin_signed_in? %>
            <%= link_to admin_root_path, class: "storefront-nav__admin" do %><%= navigation_icon(:login) %> Administração<% end %>
          <% else %>
            <%= link_to new_admin_session_path, class: "storefront-nav__admin" do %><%= navigation_icon(:login) %> Administração<% end %>
          <% end %>
        </nav>
      </div>
    </header>
    <% flash.each do |type, message| %>
      <div class="shell flash <%= "flash--alert" if type.to_s == "alert" %>" role="status"><%= message %></div>
    <% end %>
    <div id="cart-feedback" class="shell flash" role="status"></div>
    <main class="storefront-main"><%= yield %></main>
    <%= link_to carrinho_path, class: "floating-cart", data: { action: "click->cart-drawer#open" }, aria: { label: "Abrir carrinho com #{current_cart.quantity} itens" } do %>
      <%= navigation_icon(:cart) %>
      <span id="cart-count" data-cart-drawer-target="count"><%= current_cart.quantity %></span>
      <span class="visually-hidden">Abrir carrinho</span>
    <% end %>
    <aside class="cart-drawer" data-cart-drawer-target="drawer" aria-label="Carrinho" aria-hidden="true">
      <div class="cart-drawer__backdrop" data-action="click->cart-drawer#close"></div>
      <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Carrinho de compras">
        <header class="cart-drawer__header">
          <div><span class="cart-drawer__header-icon"><%= navigation_icon(:cart) %></span><div><p>Seu pedido</p><h2>Seu carrinho</h2></div></div>
          <button type="button" class="cart-drawer__close" data-action="cart-drawer#close" aria-label="Fechar carrinho"><span aria-hidden="true">×</span><span>Fechar</span></button>
        </header>
        <div id="cart-drawer-content"><%= render "cart/drawer" %></div>
      </div>
    </aside>
    <footer class="storefront-footer">
      <div class="storefront-footer__inner storefront-footer__inner--centered">
        <strong><%= brand_name %></strong>
        <nav aria-label="Links do rodapé">
          <%= link_to "Quem somos", quem_somos_path %>
          <%= link_to "Cardápio", produtos_path %>
          <%= link_to admin_signed_in? ? "Administração" : "Login", admin_signed_in? ? admin_root_path : new_admin_session_path %>
        </nav>
        <p>© <%= Time.zone.today.year %> <%= brand_name %>. Sabores preparados com carinho.</p>
        <p>Desenvolvido por <%= link_to "Lucas Martins", "https://portifolio-silk-six-70.vercel.app/", target: "_blank", rel: "noopener noreferrer" %></p>
      </div>
    </footer>
  </body>
</html>
