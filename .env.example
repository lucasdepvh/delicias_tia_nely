# Referência: exporte no shell ou configure no gerenciador de serviço.
# Rails não carrega este arquivo automaticamente. Não versionar valores reais.
RAILS_ENV=development
APP_HOST=localhost
APP_PORT=3000
APP_TIME_ZONE=America/Porto_Velho
PORT=3000
BIND_HOST=127.0.0.1
# Produção: hostname público, HTTPS no proxy, chave persistente e diretório absoluto.
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
STORAGE_PATH=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Usado apenas ao inicializar configuração ainda inexistente; não ativa vendas.
STORE_WHATSAPP=
# Recuperação de senha habilitada somente com SMTP_ADDRESS e remetente definidos.
DEVISE_MAILER_SENDER=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=
